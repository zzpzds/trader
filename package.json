{
  "name": "trader",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "dev": "concurrently \"npm run dev -w apps/web\" \"npm run dev -w apps/worker\"",
    "backfill:prices": "dotenv -e .env -- tsx scripts/backfill-price-snapshots.ts"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "concurrently": "^9.1.0",
    "dotenv-cli": "^11.0.0",
    "jsdom": "^29.1.1",
    "typescript": "^5.7.2"
  }
}
